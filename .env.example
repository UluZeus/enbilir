ENBILIR_ENV="production"
NEXT_PUBLIC_SITE_URL="https://enbilir.com"
DATABASE_URL="mysql://enbilir_app:replace-with-url-encoded-password@127.0.0.1:3306/enbilir_production"
MYSQL_DATABASE="enbilir_production"
MYSQL_DEFAULTS_FILE="/etc/enbilir/mysql-backup.cnf"
AUTH_SECRET="change-this-to-a-random-64-character-production-secret"
MASTER_ADMIN_EMAIL="admin@your-production-domain.example"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Enbilir <no-reply@example.com>"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MARKET_CHAT_MODEL="gpt-4.1-mini"
OPENAI_VIP_MARKET_CHAT_MODEL="gpt-4.1"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
AI_MARKET_AGENT_MODEL="gpt-4.1-mini"
AI_AGENT_CRON_SECRET="change-this-to-a-random-cron-secret"
AI_AGENT_CRON_ORIGIN="http://127.0.0.1:3006"
VIP_RESEARCH_CRON_SECRET="change-this-to-a-distinct-random-secret"
VIP_AGENTS_CRON_SECRET="change-this-to-a-distinct-random-secret"
AI_SIGNAL_EVALUATION_CRON_SECRET="change-this-to-a-distinct-random-secret"
SUBSCRIPTION_CRON_SECRET="change-this-to-a-distinct-random-secret"
SUBSCRIPTION_CRON_ORIGIN="http://127.0.0.1:3006"
WEEKLY_COMPETITION_CRON_SECRET="change-this-to-a-distinct-random-secret"
WEEKLY_COMPETITION_CRON_ORIGIN="http://127.0.0.1:3006"
RATE_LIMIT_HASH_SECRET="change-this-to-a-random-64-character-secret"
CHAT_UPLOAD_DIR="/srv/enbilir/uploads/chat"
ADMIN_UPLOAD_DIR="/srv/enbilir/uploads/admin"
BACKUP_DIR="/srv/enbilir/backups"
BACKUP_HEALTH_GID=""
OPERATIONS_LOG_DIR="/var/log/enbilir"
REQUIRED_JOB_HEARTBEATS="ai-agent:120,subscription-emails:1560,weekly-competition:11640,chat-upload-cleanup:1560"
MIN_FREE_DISK_BYTES="1073741824"
BACKUP_MAX_AGE_HOURS="26"
RESTORE_REHEARSAL_MAX_AGE_HOURS="744"
VIP_RESEARCH_MODEL="gpt-5.6-terra"
VIP_SUBSCRIPTION_WEBHOOK_SECRET="change-this-to-a-random-vip-webhook-secret"
PARAM_VIP_PAYMENT_URL=
