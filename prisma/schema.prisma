// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
  MASTER_ADMIN
}

enum CashMode {
  USD
  EUR
  CHF
  TRY_REPO
}

enum TradeSide {
  BUY
  SELL
}

enum DisplayNameMode {
  REAL_NAME
  NICKNAME
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum LeagueType {
  ROTARY
  ROTARACT
  INTERACT
  PRIVATE
  GENERAL
}

enum LeagueRole {
  MEMBER
  MODERATOR
  OWNER
}

enum CompetitionPeriodType {
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  YEARLY
}

enum SiteVisualSettingType {
  TEXT
  COLOR
  IMAGE_URL
  BOOLEAN
}

enum ManagedContentType {
  ANNOUNCEMENT
  BLOG
  EDUCATION
  CONTACT
}

enum ChatRoomType {
  GENERAL
  PRIVATE
}

enum ChatMessageType {
  TEXT
  FILE
  IMAGE
  VIDEO
  LOCATION
  CONTACT
  POLL
}

enum WeeklyCompetitionScope {
  WEEKLY_GAIN
  TOTAL_GAIN
}

enum MembershipTier {
  STANDARD
  VIP
}

model User {
  id                               String                       @id @default(cuid()) @db.VarChar(191)
  name                             String                       @db.VarChar(191)
  nickname                         String?                      @db.VarChar(191)
  displayNameMode                  DisplayNameMode              @default(REAL_NAME)
  email                            String                       @unique @db.VarChar(254)
  passwordHash                     String?                      @db.VarChar(128)
  isActive                         Boolean                      @default(false)
  emailVerifiedAt                  DateTime?                    @db.DateTime(3)
  emailVerificationTokenHash       String?                      @db.VarChar(128)
  emailVerificationExpiresAt       DateTime?                    @db.DateTime(3)
  emailVerificationSentAt          DateTime?                    @db.DateTime(3)
  role                             Role                         @default(USER)
  membershipTier                   MembershipTier               @default(STANDARD)
  sessionVersion                   Int                          @default(0)
  vipStartedAt                     DateTime?                    @db.DateTime(3)
  vipPaidUntil                     DateTime?                    @db.DateTime(3)
  vipLastReminderSentAt            DateTime?                    @db.DateTime(3)
  score                            Int                          @default(0)
  kvkkDisclosureAccepted           Boolean                      @default(false)
  kvkkDisclosureAcceptedAt         DateTime?                    @db.DateTime(3)
  termsAccepted                    Boolean                      @default(false)
  termsAcceptedAt                  DateTime?                    @db.DateTime(3)
  noInvestmentAdviceAccepted       Boolean                      @default(false)
  noInvestmentAdviceAcceptedAt     DateTime?                    @db.DateTime(3)
  electronicCommunicationConsent   Boolean                      @default(false)
  electronicCommunicationConsentAt DateTime?                    @db.DateTime(3)
  onboardingGuideCompletedAt       DateTime?                    @db.DateTime(3)
  riskAppetiteCompletedAt          DateTime?                    @db.DateTime(3)
  riskAppetiteScore                Float?
  riskAppetiteProfile              String?                      @db.VarChar(191)
  aiAssistantOnboardingCompletedAt DateTime?                    @db.DateTime(3)
  aiChatOnboardingCompletedAt      DateTime?                    @db.DateTime(3)
  leaderboardOnboardingCompletedAt DateTime?                    @db.DateTime(3)
  onboardingCompletedAt            DateTime?                    @db.DateTime(3)
  supportIntroShownAt              DateTime?                    @db.DateTime(3)
  createdAt                        DateTime                     @default(now()) @db.DateTime(3)
  updatedAt                        DateTime                     @updatedAt @db.DateTime(3)
  virtualAccount                   VirtualAccount?
  positions                        PortfolioPosition[]
  trades                           VirtualTrade[]
  sentFriendRequests               FriendRequest[]              @relation("SentFriendRequests")
  receivedFriendRequests           FriendRequest[]              @relation("ReceivedFriendRequests")
  createdLeagues                   League[]                     @relation("CreatedLeagues")
  leagueMemberships                LeagueMembership[]
  badges                           UserBadge[]
  achievementEvents                AchievementEvent[]
  portfolioSnapshots               PortfolioSnapshot[]
  oauthAccounts                    OAuthAccount[]
  aiMarketFavorites                AiMarketFavorite[]
  aiMarketReports                  AiMarketReport[]
  aiMarketReportEvents             AiMarketReportEvent[]
  subscriptionEmailLogs            SubscriptionEmailLog[]
  siteAnalyticsEvents              SiteAnalyticsEvent[]
  createdChatRooms                 ChatRoom[]                   @relation("CreatedChatRooms")
  chatMessages                     ChatMessage[]
  chatPresences                    ChatPresence[]
  chatPollVotes                    ChatPollVote[]
  weeklyPortfolioBaselines         WeeklyPortfolioBaseline[]
  weeklyCompetitionRows            WeeklyCompetitionResultRow[]
  reportedChatMessages             ChatMessageReport[]          @relation("ChatMessageReportsByReporter")
  hiddenChatMessages               ChatMessage[]                @relation("HiddenChatMessages")
  blockedChatUsers                 ChatUserBlock[]              @relation("ChatUserBlocksByBlocker")
  blockedByChatUsers               ChatUserBlock[]              @relation("ChatUserBlocksByBlocked")
  vipResearchEmailLogs             VipResearchEmailLog[]
  vipSubscriptionPayments          VipSubscriptionPayment[]
  vipSubscriptionClaims            VipSubscriptionClaim[]
  aiDailyQueryUsages               AiDailyQueryUsage[]
  aiQueryReservations              AiQueryReservation[]
  supportReminderPeriods           SupportReminderPeriod[]
  supportReminderEntries           SupportReminderEntry[]
  chatRoomMemberships              ChatRoomMembership[]
  chatUploads                      ChatUpload[]
}

model OAuthState {
  stateHash String   @id @db.VarChar(128)
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid()) @db.VarChar(191)
  provider          String   @db.VarChar(191)
  providerAccountId String   @db.VarChar(191)
  userId            String   @db.VarChar(191)
  createdAt         DateTime @default(now()) @db.DateTime(3)
  updatedAt         DateTime @updatedAt @db.DateTime(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model BlogPost {
  id        String   @id @default(cuid()) @db.VarChar(191)
  slug      String   @unique @db.VarChar(191)
  titleTr   String   @db.VarChar(191)
  titleEn   String   @db.VarChar(191)
  excerptTr String   @db.Text
  excerptEn String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

model AdPlacement {
  id             String    @id @default(cuid()) @db.VarChar(191)
  slot           String    @db.VarChar(191)
  title          String    @db.VarChar(191)
  body           String    @db.LongText
  imageUrl       String?   @db.Text
  videoUrl       String?   @db.Text
  linkUrl        String?   @db.Text
  linkLabel      String?   @db.VarChar(191)
  isActive       Boolean   @default(true)
  displaySeconds Int       @default(8)
  priority       Int       @default(0)
  startsAt       DateTime? @db.DateTime(3)
  endsAt         DateTime? @db.DateTime(3)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  @@index([slot, isActive, priority])
}

model ManagedContentPage {
  id        String   @id @default(cuid()) @db.VarChar(191)
  code      String   @unique @db.VarChar(191)
  title     String   @db.VarChar(191)
  body      String   @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

model ManagedContentItem {
  id          String             @id @default(cuid()) @db.VarChar(191)
  type        ManagedContentType
  locale      String             @default("tr") @db.VarChar(191)
  title       String             @db.VarChar(191)
  excerpt     String?            @db.Text
  body        String             @db.LongText
  imageUrl    String?            @db.Text
  videoUrl    String?            @db.Text
  linkUrl     String?            @db.Text
  linkLabel   String?            @db.VarChar(191)
  sortOrder   Int                @default(0)
  isFeatured  Boolean            @default(false)
  isActive    Boolean            @default(true)
  publishedAt DateTime?          @db.DateTime(3)
  createdAt   DateTime           @default(now()) @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @db.DateTime(3)

  @@index([type, locale, isActive, sortOrder])
  @@index([isFeatured, isActive])
}

model SiteVisualSetting {
  id          String                @id @default(cuid()) @db.VarChar(191)
  key         String                @unique @db.VarChar(191)
  title       String                @db.VarChar(191)
  value       String                @db.LongText
  type        SiteVisualSettingType
  description String?               @db.Text
  createdAt   DateTime              @default(now()) @db.DateTime(3)
  updatedAt   DateTime              @updatedAt @db.DateTime(3)

  @@index([type])
}

model VirtualAccount {
  id                String    @id @default(cuid()) @db.VarChar(191)
  userId            String    @unique @db.VarChar(191)
  cashMode          CashMode  @default(USD)
  cashAmount        Decimal   @default(1000000) @db.Decimal(30, 8)
  baseCurrency      String    @default("USD") @db.VarChar(191)
  dailyRepoRate     Decimal   @default(0.00125) @db.Decimal(36, 12)
  repoLastAccruedAt DateTime? @db.DateTime(3)
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioPosition {
  id                        String    @id @default(cuid()) @db.VarChar(191)
  userId                    String    @db.VarChar(191)
  positionCycleId           String?   @db.VarChar(191)
  symbol                    String    @db.VarChar(191)
  providerSymbol            String?   @db.VarChar(191)
  name                      String    @db.VarChar(191)
  market                    String    @db.VarChar(191)
  quantity                  Decimal   @db.Decimal(36, 12)
  averagePriceUsd           Decimal   @db.Decimal(30, 8)
  appliedSplitFactor        Decimal   @default(1) @db.Decimal(36, 12)
  corporateActionsCheckedAt DateTime? @db.DateTime(3)
  delistedAt                DateTime? @db.DateTime(3)
  createdAt                 DateTime  @default(now()) @db.DateTime(3)
  updatedAt                 DateTime  @updatedAt @db.DateTime(3)
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model VirtualTrade {
  id                   String    @id @default(cuid()) @db.VarChar(191)
  userId               String    @db.VarChar(191)
  idempotencyKey       String?   @db.VarChar(191)
  positionCycleId      String?   @db.VarChar(191)
  symbol               String    @db.VarChar(191)
  name                 String    @db.VarChar(191)
  market               String    @db.VarChar(191)
  side                 TradeSide
  quantity             Decimal   @db.Decimal(36, 12)
  priceUsd             Decimal   @db.Decimal(30, 8)
  totalUsd             Decimal   @db.Decimal(30, 8)
  requestedAmountUsd   Decimal   @default(0) @db.Decimal(30, 8)
  executionNotionalUsd Decimal   @default(0) @db.Decimal(30, 8)
  feeUsd               Decimal   @default(0) @db.Decimal(30, 8)
  slippageUsd          Decimal   @default(0) @db.Decimal(30, 8)
  costBasisUsd         Decimal?  @db.Decimal(30, 8)
  realizedPnlUsd       Decimal?  @db.Decimal(30, 8)
  realizedPnlPercent   Decimal?  @db.Decimal(24, 12)
  quoteCurrency        String    @default("USD") @db.VarChar(191)
  priceSource          String    @default("UNKNOWN") @db.VarChar(191)
  priceAsOf            DateTime? @db.DateTime(3)
  reason               String?   @db.Text
  createdAt            DateTime  @default(now()) @db.DateTime(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model FriendRequest {
  id         String              @id @default(cuid()) @db.VarChar(191)
  pairKey    String              @unique @db.VarChar(191)
  senderId   String              @db.VarChar(191)
  receiverId String              @db.VarChar(191)
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @db.DateTime(3)
  updatedAt  DateTime            @updatedAt @db.DateTime(3)
  sender     User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([receiverId, status])
}

model League {
  id              String             @id @default(cuid()) @db.VarChar(191)
  name            String             @db.VarChar(191)
  slug            String             @unique @db.VarChar(191)
  description     String?            @db.Text
  type            LeagueType
  inviteCode      String             @unique @db.VarChar(191)
  createdByUserId String             @db.VarChar(191)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now()) @db.DateTime(3)
  updatedAt       DateTime           @updatedAt @db.DateTime(3)
  createdBy       User               @relation("CreatedLeagues", fields: [createdByUserId], references: [id], onDelete: Cascade)
  memberships     LeagueMembership[]

  @@index([type, isActive])
  @@index([createdByUserId])
}

model LeagueMembership {
  id       String     @id @default(cuid()) @db.VarChar(191)
  leagueId String     @db.VarChar(191)
  userId   String     @db.VarChar(191)
  role     LeagueRole @default(MEMBER)
  joinedAt DateTime   @default(now()) @db.DateTime(3)
  league   League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
}

model Badge {
  id            String      @id @default(cuid()) @db.VarChar(191)
  code          String      @unique @db.VarChar(191)
  nameTr        String      @db.VarChar(191)
  nameEn        String      @db.VarChar(191)
  descriptionTr String      @db.Text
  descriptionEn String      @db.Text
  icon          String      @db.VarChar(191)
  category      String      @db.VarChar(191)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @db.DateTime(3)
  users         UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid()) @db.VarChar(191)
  userId   String   @db.VarChar(191)
  badgeId  String   @db.VarChar(191)
  earnedAt DateTime @default(now()) @db.DateTime(3)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId])
}

model AchievementEvent {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  type      String   @db.VarChar(191)
  metadata  String?  @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model CompetitionPeriod {
  id        String                @id @default(cuid()) @db.VarChar(191)
  type      CompetitionPeriodType
  name      String                @db.VarChar(191)
  startsAt  DateTime              @db.DateTime(3)
  endsAt    DateTime              @db.DateTime(3)
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now()) @db.DateTime(3)
  updatedAt DateTime              @updatedAt @db.DateTime(3)
  snapshots PortfolioSnapshot[]

  @@index([type, isActive])
  @@index([startsAt, endsAt])
}

model PortfolioSnapshot {
  id                String            @id @default(cuid()) @db.VarChar(191)
  userId            String            @db.VarChar(191)
  periodId          String            @db.VarChar(191)
  startingValueUsd  Decimal           @default(1000000) @db.Decimal(30, 8)
  portfolioValueUsd Decimal           @db.Decimal(30, 8)
  cashUsd           Decimal           @db.Decimal(30, 8)
  positionsValueUsd Decimal           @db.Decimal(30, 8)
  returnPercent     Decimal           @db.Decimal(24, 12)
  valuationStatus   String            @default("VERIFIED") @db.VarChar(191)
  rank              Int?
  capturedAt        DateTime          @default(now()) @db.DateTime(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  period            CompetitionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([userId, periodId])
  @@index([periodId, rank])
  @@index([userId])
}

model WeeklyPortfolioBaseline {
  id                String   @id @default(cuid()) @db.VarChar(191)
  periodKey         String   @db.VarChar(191)
  userId            String   @db.VarChar(191)
  portfolioValueUsd Decimal  @db.Decimal(30, 8)
  capturedAt        DateTime @default(now()) @db.DateTime(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodKey, userId])
  @@index([capturedAt])
  @@index([userId])
}

model WeeklyCompetitionPublication {
  id          String                       @id @default(cuid()) @db.VarChar(191)
  periodKey   String                       @unique @db.VarChar(191)
  startsAt    DateTime                     @db.DateTime(3)
  endsAt      DateTime                     @db.DateTime(3)
  publishedAt DateTime                     @db.DateTime(3)
  note        String?                      @db.Text
  createdAt   DateTime                     @default(now()) @db.DateTime(3)
  updatedAt   DateTime                     @updatedAt @db.DateTime(3)
  rows        WeeklyCompetitionResultRow[]

  @@index([publishedAt])
  @@index([startsAt, endsAt])
}

model WeeklyCompetitionResultRow {
  id            String                       @id @default(cuid()) @db.VarChar(191)
  publicationId String                       @db.VarChar(191)
  scope         WeeklyCompetitionScope
  userId        String                       @db.VarChar(191)
  displayName   String                       @db.VarChar(191)
  valueUsd      Decimal                      @db.Decimal(30, 8)
  returnPercent Decimal                      @db.Decimal(24, 12)
  rank          Int
  createdAt     DateTime                     @default(now()) @db.DateTime(3)
  publication   WeeklyCompetitionPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publicationId, scope, userId])
  @@unique([publicationId, scope, rank])
  @@index([scope, rank])
  @@index([userId, scope])
}

model AiSignalLog {
  id                 String               @id @default(cuid()) @db.VarChar(191)
  createdAt          DateTime             @default(now()) @db.DateTime(3)
  symbol             String               @db.VarChar(191)
  displayName        String?              @db.VarChar(191)
  exchange           String?              @db.VarChar(191)
  interval           String               @db.VarChar(191)
  signalType         String               @db.VarChar(191)
  recommendationText String?              @db.Text
  confidence         Float?
  riskScore          Float?
  opportunityScore   Float?
  priceAtSignal      Decimal?             @db.Decimal(30, 8)
  currency           String?              @db.VarChar(191)
  source             String?              @db.VarChar(191)
  reason             String?              @db.Text
  indicatorsSnapshot Json?
  rawPayload         Json?
  evaluations        AiSignalEvaluation[]

  @@index([createdAt])
  @@index([symbol, interval, signalType, createdAt])
  @@index([source, createdAt])
}

model AiSignalEvaluation {
  id                 String      @id @default(cuid()) @db.VarChar(191)
  signalLogId        String      @db.VarChar(191)
  signalLog          AiSignalLog @relation(fields: [signalLogId], references: [id], onDelete: Cascade)
  horizon            String      @db.VarChar(191)
  evaluatedAt        DateTime    @default(now()) @db.DateTime(3)
  priceAtEvaluation  Decimal?    @db.Decimal(30, 8)
  priceChangePercent Decimal?    @db.Decimal(24, 12)
  directionCorrect   Boolean?
  score              Float?
  resultLabel        String?     @db.VarChar(191)
  status             String?     @db.VarChar(191)

  @@unique([signalLogId, horizon])
  @@index([horizon, evaluatedAt])
  @@index([status])
}

model AiMarketFavorite {
  id          String   @id @default(cuid()) @db.VarChar(191)
  userId      String   @db.VarChar(191)
  symbol      String   @db.VarChar(191)
  displayName String?  @db.VarChar(191)
  assetClass  String?  @db.VarChar(191)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId, createdAt])
}

model AiMarketReport {
  id               String                   @id @default(cuid()) @db.VarChar(191)
  userId           String?                  @db.VarChar(191)
  audienceKey      String                   @db.VarChar(191)
  periodKey        String                   @db.VarChar(191)
  scope            String                   @default("GLOBAL") @db.VarChar(191)
  status           String                   @default("COMPLETED") @db.VarChar(191)
  model            String?                  @db.VarChar(191)
  generatedAt      DateTime                 @default(now()) @db.DateTime(3)
  macroSummary     String                   @db.LongText
  marketRegime     String?                  @db.VarChar(512)
  riskAppetite     String?                  @db.VarChar(512)
  keyTakeaways     Json
  requiredCoverage Json
  newsSummary      String?                  @db.LongText
  dataSnapshot     Json?
  rawAiPayload     Json?
  fallbackUsed     Boolean                  @default(false)
  disclaimer       String                   @db.Text
  createdAt        DateTime                 @default(now()) @db.DateTime(3)
  updatedAt        DateTime                 @updatedAt @db.DateTime(3)
  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  assets           AiMarketReportAsset[]
  newsItems        AiMarketReportNewsItem[]
  events           AiMarketReportEvent[]

  @@unique([userId, periodKey, scope])
  @@unique([audienceKey, periodKey, scope])
  @@index([generatedAt])
  @@index([userId, generatedAt])
}

model AiMarketReportEvent {
  id        String         @id @default(cuid()) @db.VarChar(191)
  reportId  String         @db.VarChar(191)
  userId    String?        @db.VarChar(191)
  eventType String         @db.VarChar(191)
  metadata  Json?
  createdAt DateTime       @default(now()) @db.DateTime(3)
  report    AiMarketReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reportId, eventType, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([eventType, createdAt])
}

model AiMarketReportAsset {
  id                  String         @id @default(cuid()) @db.VarChar(191)
  reportId            String         @db.VarChar(191)
  symbol              String         @db.VarChar(191)
  displayName         String         @db.VarChar(191)
  assetClass          String         @db.VarChar(191)
  category            String?        @db.VarChar(191)
  lastPrice           Decimal?       @db.Decimal(30, 8)
  changePercent       Decimal?       @db.Decimal(24, 12)
  signalType          String?        @db.VarChar(191)
  confidence          Float?
  riskScore           Float?
  opportunityScore    Float?
  technicalCommentary String         @db.LongText
  macroCommentary     String?        @db.LongText
  newsCommentary      String?        @db.LongText
  watchLevels         Json?
  scenarios           Json?
  sourcePayload       Json?
  createdAt           DateTime       @default(now()) @db.DateTime(3)
  report              AiMarketReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, symbol])
  @@index([symbol, createdAt])
}

model AiMarketReportNewsItem {
  id          String         @id @default(cuid()) @db.VarChar(191)
  reportId    String         @db.VarChar(191)
  title       String         @db.VarChar(512)
  link        String         @db.Text
  source      String         @db.VarChar(191)
  publishedAt DateTime?      @db.DateTime(3)
  category    String?        @db.VarChar(191)
  relevance   Float?
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  report      AiMarketReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, relevance])
  @@index([category, createdAt])
}

model SubscriptionEmailLog {
  id        String   @id @default(cuid()) @db.VarChar(191)
  userId    String   @db.VarChar(191)
  email     String   @db.VarChar(254)
  emailType String   @db.VarChar(191)
  periodKey String   @db.VarChar(191)
  subject   String   @db.Text
  sentAt    DateTime @default(now()) @db.DateTime(3)
  metadata  Json?
  createdAt DateTime @default(now()) @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

